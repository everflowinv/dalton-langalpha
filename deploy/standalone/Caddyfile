# Dalton Standalone Core edge gateway (Batch 6: Loopback HTTP / Internal CA / Automatic HTTPS / Custom TLS).
#
# Mode selection is controlled by DALTON_TLS_MODE (imported from /etc/caddy/modes/*.caddy):
#   - loopback (default): plain HTTP on :8088, published only on 127.0.0.1:${DALTON_EDGE_PORT:-8088}
#   - internal:           HTTPS on :443 using Caddy's built-in internal CA (localhost or LAN/private hosts)
#   - auto:               Automatic HTTPS (ACME / Let's Encrypt) on :80 and :443 for public domains
#   - custom:             HTTPS on :443 using operator-provided certificates in /etc/caddy/certs/
#
# Every mode shares the exact same (dalton_site_common) route table, header stripping,
# access-log redaction, and internal-endpoint blocking boundary.
{
	admin off
}

# Shared internal-header stripping snippets imported by /api/*, /ws/*,
# /api/v1/threads/*/messages/replay, and CI probe routes so every proxied route
# executes the exact same stripping definition.
(strip_internal_request_headers) {
	request_header -X-Service-Token
	request_header -X-User-Id
}

(strip_internal_upstream_headers) {
	header_up -X-Service-Token
	header_up -X-User-Id
}

# Redact ?token=<jwt> / ?dl_token= / ?ticket= / ?code= / ?state= and path share tokens
# (/api/v1/public/shared/<token>, /s/<token>, /a/<token>, /og-meta?path=/s/<token>)
# in a single filter layer (Caddy 2.9.1 nested filters do not receive full
# request>uri / request>headers>Referer field paths), delete sensitive
# authentication / internal headers, and strip response Location headers from
# access logs so HTTP->HTTPS redirects or tokens never leak into logs
# (Caddy logs the original request before header mutation).
(dalton_access_log) {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp `(^/+api/v1/public/shared/+|^/+(?:s|a)/+|[?&]path=(?:/+|%2[fF])(?:s|a)(?:/+|%2[fF]))[^/?&#]+|([?&](?:token|dl_token|ticket|code|state)=)[^&#]+` `${1}${2}REDACTED`
				request>headers>Referer regexp `(https?://[^/?#]+(?:/+api/v1/public/shared/+|/+(?:s|a)/+)|[?&]path=(?:/+|%2[fF])(?:s|a)(?:/+|%2[fF]))[^/?&#]+|([?&](?:token|dl_token|ticket|code|state)=)[^&#]+` `${1}${2}REDACTED`
				request>headers>X-Service-Token delete
				request>headers>X-User-Id delete
				request>headers>X-Dalton-Relay-Token delete
				# Go net/http canonicalizes X-LangAlpha-Owner -> X-Langalpha-Owner in logged request headers.
				request>headers>X-Langalpha-Owner delete
				request>headers>Authorization delete
				request>headers>Cookie delete
				resp_headers>Location delete
			}
		}
	}
}

# HTTP (:80) -> HTTPS redirect that preserves a non-default host HTTPS port
# (e.g. 18443 in loopback HTTPS mode) while omitting :443 on standard deployments.
# IPv6 literals are explicitly re-bracketed because Caddy's {http.request.host}
# strips brackets when Host carries a port (e.g. [::1]:18080 -> ::1).
(dalton_http_redirect) {
	import dalton_access_log
	@ipv6_non_default_https_port {
		vars_regexp ipv6_host {http.request.host} ^\[?([^\[\]]*:[^\[\]]+)\]?$
		expression `"{$DALTON_EDGE_HTTPS_PORT:443}" != "443" && "{$DALTON_EDGE_HTTPS_PORT:443}" != ""`
	}
	handle @ipv6_non_default_https_port {
		redir https://[{re.ipv6_host.1}]:{$DALTON_EDGE_HTTPS_PORT:443}{uri} permanent
	}
	@ipv6_default_https_port {
		vars_regexp ipv6_host_def {http.request.host} ^\[?([^\[\]]*:[^\[\]]+)\]?$
	}
	handle @ipv6_default_https_port {
		redir https://[{re.ipv6_host_def.1}]{uri} permanent
	}
	@non_default_https_port expression `"{$DALTON_EDGE_HTTPS_PORT:443}" != "443" && "{$DALTON_EDGE_HTTPS_PORT:443}" != ""`
	handle @non_default_https_port {
		redir https://{host}:{$DALTON_EDGE_HTTPS_PORT:443}{uri} permanent
	}
	handle {
		redir https://{host}{uri} permanent
	}
}

# Shared site configuration imported by every TLS / loopback mode block.
(dalton_site_common) {
	root * /srv
	encode zstd gzip
	# Disable response compression on share pages so site-level encode cannot
	# open an empty gzip stream before handle_errors falls back to static index.html.
	request_header @share_pages -Accept-Encoding
	import dalton_access_log

	# Baseline security response headers.
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	# Optional site-block snippets (e.g. CI header-stripping probe routes).
	import /etc/caddy/extra/*.caddy

	# Never expose the sandbox-only chat-upload relay endpoint through the edge;
	# sandboxes dial http://backend:8000 directly over the isolated sandbox network.
	@blocked_internal_api path /api/v1/dalton/chat-uploads/sandbox-object /api/v1/dalton/chat-uploads/sandbox-object/*
	handle @blocked_internal_api {
		respond 404
	}

	# 0. History replay (/api/v1/threads/<id>/messages/replay) is a finite SSE
	# response that can run to 10+ MB on a long thread. Compress regardless of
	# the first flushed event's size while applying the shared stripping snippets.
	@history_replay path_regexp history_replay ^/api/v1/threads/[^/]+/messages/replay$
	handle @history_replay {
		import strip_internal_request_headers
		encode {
			zstd
			gzip
			minimum_length 1
			match {
				header Content-Type text/event-stream*
			}
		}
		reverse_proxy backend:8000 {
			import strip_internal_upstream_headers
			flush_interval -1
		}
	}

	# 0b. Public OpenGraph meta fragment (/api/v1/public/og-meta):
	#     always anonymous — strip visitor credentials and compression negotiation before
	#     proxying so Caddy's httpInclude never forwards cookies/auth headers or receives
	#     compressed bytes, and bound upstream wait so handle_errors falls back promptly.
	@public_og_meta path /api/v1/public/og-meta
	handle @public_og_meta {
		import strip_internal_request_headers
		request_header -Authorization
		request_header -Cookie
		request_header -Accept-Encoding
		reverse_proxy backend:8000 {
			import strip_internal_upstream_headers
			header_up -Authorization
			header_up -Cookie
			header_up -Accept-Encoding
			transport http {
				dial_timeout 2s
				response_header_timeout 3s
			}
		}
	}

	# 1. Reverse proxy /api/* and /ws/* to backend:8000 using the shared stripping
	# snippets so external X-Service-Token and X-User-Id headers cannot invoke the
	# internal service-token channel through the edge gateway.
	# flush_interval -1 disables response buffering for SSE; WebSocket upgrades are native.
	@backend_routes path /api/* /ws/*
	handle @backend_routes {
		import strip_internal_request_headers
		reverse_proxy backend:8000 {
			import strip_internal_upstream_headers
			flush_interval -1
		}
	}

	# 1b. Read-only avatar proxy (GET/HEAD /storage/<prefix>avatars/* -> MinIO current version only,
	#     stripping all query parameters including versionId and response-* overrides);
	#     every other /storage/* path or method returns 404.
	@storage_avatars {
		method GET HEAD
		expression `("{$STORAGE_KEY_PREFIX:}" == "" && {path}.startsWith("/storage/avatars/") && {path} != "/storage/avatars/") || ("{$STORAGE_KEY_PREFIX:}" != "" && {path}.startsWith("/storage/" + ("{$STORAGE_KEY_PREFIX:}".endsWith("/") ? "{$STORAGE_KEY_PREFIX:}" : "{$STORAGE_KEY_PREFIX:}" + "/") + "avatars/") && {path} != "/storage/" + ("{$STORAGE_KEY_PREFIX:}".endsWith("/") ? "{$STORAGE_KEY_PREFIX:}" : "{$STORAGE_KEY_PREFIX:}" + "/") + "avatars/")`
	}
	handle @storage_avatars {
		route {
			uri strip_prefix /storage
			rewrite * /{$STORAGE_BUCKET_NAME:dalton-storage}{path}?
			import strip_internal_request_headers
			request_header -Authorization
			request_header -Cookie
			reverse_proxy minio:9000 {
				import strip_internal_upstream_headers
				header_up -Authorization
				header_up -Cookie
			}
		}
	}

	@storage_blocked path /storage /storage/*
	handle @storage_blocked {
		respond 404
	}

	# 2. Build version manifest (/version.json): never cached, never SPA-fallback.
	@version_manifest {
		method GET HEAD
		path /version.json
	}
	handle @version_manifest {
		header Cache-Control "no-cache, no-store, must-revalidate"
		file_server
	}

	# 3. Hashed build assets (/assets/*): long-cached when present, real 404 when absent.
	@static_assets {
		method GET HEAD
		path /assets/*
	}
	handle @static_assets {
		@asset_exists file
		header @asset_exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# 4. Reject backend-only root endpoints outside /api/* and /ws/* with 404.
	@blocked_paths path /health /health/* /docs /docs/* /redoc /redoc/* /openapi.json /metrics /metrics/*
	handle @blocked_paths {
		respond 404
	}

	# 5. Static documentation site (/help, /help/*):
	#    hashed assets under /help/_astro/* are long-cached; HTML is never cached;
	#    missing paths return HTTP 404 with /help/404.html instead of the app SPA.
	@help_assets {
		method GET HEAD
		path /help/_astro/*
	}
	handle @help_assets {
		@help_asset_exists file
		header @help_asset_exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@help_docs {
		method GET HEAD
		path /help /help/*
	}
	handle @help_docs {
		route {
			try_files {path}/index.html {path} {path}.html
			@help_html path *.html
			header @help_html Cache-Control "no-cache, no-store, must-revalidate"
			file_server
		}
	}

	handle_errors {
		@help_404 {
			expression {err.status_code} == 404
			path /help /help/*
			not path /help/_astro/*
		}
		handle @help_404 {
			header Cache-Control "no-cache, no-store, must-revalidate"
			rewrite * /help/404.html
			file_server
		}
		@share_og_fallback {
			expression {err.status_code} >= 500
			vars og_share_fallback 1
		}
		handle @share_og_fallback {
			header Cache-Control "no-cache, no-store, must-revalidate"
			rewrite * /index.html
			file_server {
				status 200
			}
		}
	}

	# 5b. Public share pages (/s/<token>, /a/<token>): render index.html through Caddy
	#     templates with custom <!--@ @--> delimiters so httpInclude injects per-link
	#     OpenGraph <meta> tags from /api/v1/public/og-meta. If the backend is unavailable,
	#     handle_errors (@share_og_fallback) falls back to static index.html (brand name) with 200.
	@share_pages {
		method GET HEAD
		path_regexp share_pages ^/(?:s|a)/[^/]+/?$
	}
	handle @share_pages {
		route {
			vars og_share_fallback 1
			rewrite * /index.html
			header Cache-Control "no-cache, no-store, must-revalidate"
			templates {
				between <!--@ @-->
				mime text/html
			}
			file_server
		}
	}

	# 6. SPA static files & index.html fallback (GET/HEAD only; index.html is never cached).
	@spa_read {
		method GET HEAD
	}
	handle @spa_read {
		route {
			rewrite / /index.html
			try_files {path} /index.html
			@index_doc path /index.html
			header @index_doc Cache-Control "no-cache, no-store, must-revalidate"
			file_server
		}
	}

	# 7. All other paths / methods outside /api/*, /ws/*, and static GET/HEAD return 404.
	handle {
		respond 404
	}
}

# Activate the configured TLS / loopback listener mode.
import /etc/caddy/modes/{$DALTON_TLS_MODE:loopback}.caddy

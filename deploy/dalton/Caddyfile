# Dalton public edge gateway (Tailscale Funnel :8443 -> 127.0.0.1:8088 -> Caddy)
# TLS terminates at Tailscale Funnel; Caddy serves plain HTTP on 127.0.0.1:8088.
{
	auto_https off
	admin off
}

:8088 {
	root * /srv-releases/current
	encode zstd gzip
	# Disable response compression on share pages so site-level encode cannot
	# open an empty gzip stream before handle_errors falls back to static index.html.
	request_header @share_pages -Accept-Encoding

	# Redact sensitive query params (?token=, ?dl_token=) and path share tokens
	# (/api/v1/public/shared/<token>, /s/<token>, /a/<token>, /og-meta?path=/s/<token>)
	# in access logs in a single filter layer (Caddy 2.9.1 nested filters do not see
	# full request>uri / request>headers>Referer field paths) while preserving
	# non-sensitive path/query info for troubleshooting.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp `(^/+api/v1/public/shared/+|^/+(?:s|a)/+|[?&]path=(?:/+|%2[fF])(?:s|a)(?:/+|%2[fF]))[^/?&#]+|([?&](?:token|dl_token)=)[^&#]+` `${1}${2}REDACTED`
				request>headers>Referer regexp `(https?://[^/?#]+(?:/+api/v1/public/shared/+|/+(?:s|a)/+)|[?&]path=(?:/+|%2[fF])(?:s|a)(?:/+|%2[fF]))[^/?&#]+|([?&](?:token|dl_token)=)[^&#]+` `${1}${2}REDACTED`
			}
		}
	}

	# Baseline security response headers.
	# Strict-Transport-Security is intentionally omitted because TLS terminates at Tailscale Funnel.
	# Content-Security-Policy is deferred to a follow-up item (see docs/dalton/dev-guide/PUBLIC-DEPLOY.md).
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	# 0a. Edge readiness probe (independent of frontend static files so deploy_main.sh
	#     can confirm Caddy is serving the releases Caddyfile before switching web/releases/current).
	@edge_health {
		method GET HEAD
		path /__edge_health
	}
	handle @edge_health {
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "no-cache, no-store, must-revalidate"
		header X-Dalton-Edge-Ready "releases-v1"
		respond "dalton-edge-ok releases-v1" 200
	}

	# 0. History replay (/api/v1/threads/<id>/messages/replay) is a finite SSE
	# response that can run to 10+ MB on a long thread (tool results and
	# provenance), and the chat view reveals nothing until it has all arrived.
	# The global encode skips it whenever the first flushed event (history_page,
	# ~60 bytes) is under encode's 512-byte minimum_length, which flush_interval
	# -1 makes the common case, so long replays went out uncompressed. Compress
	# this route regardless of the first chunk: about 4x smaller (12.5 MB ->
	# 2.9 MB gzip on a real thread). Same header stripping and proxying as the
	# general backend route below.
	@history_replay path_regexp history_replay ^/api/v1/threads/[^/]+/messages/replay$
	handle @history_replay {
		request_header -X-Service-Token
		request_header -X-User-Id
		encode {
			zstd
			gzip
			minimum_length 1
			match {
				header Content-Type text/event-stream*
			}
		}
		reverse_proxy backend:8000 {
			header_up -X-Service-Token
			header_up -X-User-Id
			flush_interval -1
		}
	}

	# 0b. Public OpenGraph meta fragment (/api/v1/public/og-meta):
	#     always anonymous — strip visitor credentials and compression negotiation before
	#     proxying so Caddy's httpInclude never forwards cookies/auth headers or receives
	#     compressed bytes, and bound upstream wait so handle_errors falls back promptly.
	@public_og_meta path /api/v1/public/og-meta
	handle @public_og_meta {
		request_header -X-Service-Token
		request_header -X-User-Id
		request_header -Authorization
		request_header -Cookie
		request_header -Accept-Encoding
		reverse_proxy backend:8000 {
			header_up -X-Service-Token
			header_up -X-User-Id
			header_up -Authorization
			header_up -Cookie
			header_up -Accept-Encoding
			transport http {
				dial_timeout 2s
				response_header_timeout 3s
			}
		}
	}

	# 1. Reverse proxy only /api/* and /ws/* to backend:8000.
	# Strip external X-Service-Token and X-User-Id headers so the internal service-token
	# channel cannot be invoked from the public edge.
	# flush_interval -1 disables response buffering for SSE streams; WebSocket upgrades are native.
	@backend_routes path /api/* /ws/*
	handle @backend_routes {
		request_header -X-Service-Token
		request_header -X-User-Id
		reverse_proxy backend:8000 {
			header_up -X-Service-Token
			header_up -X-User-Id
			flush_interval -1
		}
	}

	# 1b. Read-only avatar proxy (GET/HEAD /storage/<prefix>avatars/* -> MinIO current version only,
	#     stripping all query parameters including versionId and response-* overrides);
	#     every other /storage/* path or method returns 404.
	@storage_avatars {
		method GET HEAD
		expression `("{$STORAGE_KEY_PREFIX:}" == "" && {path}.startsWith("/storage/avatars/") && {path} != "/storage/avatars/") || ("{$STORAGE_KEY_PREFIX:}" != "" && {path}.startsWith("/storage/" + ("{$STORAGE_KEY_PREFIX:}".endsWith("/") ? "{$STORAGE_KEY_PREFIX:}" : "{$STORAGE_KEY_PREFIX:}" + "/") + "avatars/") && {path} != "/storage/" + ("{$STORAGE_KEY_PREFIX:}".endsWith("/") ? "{$STORAGE_KEY_PREFIX:}" : "{$STORAGE_KEY_PREFIX:}" + "/") + "avatars/")`
	}
	handle @storage_avatars {
		route {
			uri strip_prefix /storage
			rewrite * /{$STORAGE_BUCKET_NAME:dalton-main}{path}?
			request_header -X-Service-Token
			request_header -X-User-Id
			request_header -Authorization
			request_header -Cookie
			reverse_proxy minio:9000 {
				header_up -X-Service-Token
				header_up -X-User-Id
				header_up -Authorization
				header_up -Cookie
			}
		}
	}

	@storage_blocked path /storage /storage/*
	handle @storage_blocked {
		respond 404
	}

	# 2. Build version manifest (/version.json): never cached, never SPA-fallback (must 404 when absent).
	@version_manifest {
		method GET HEAD
		path /version.json
	}
	handle @version_manifest {
		header Cache-Control "no-cache, no-store, must-revalidate"
		file_server
	}

	# 3. Hashed build assets (/assets/*): long-cached when present, real 404 when absent (no SPA fallback).
	@static_assets {
		method GET HEAD
		path /assets/*
	}
	handle @static_assets {
		@asset_exists file
		header @asset_exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# 4. Reject backend-only root endpoints outside /api/* and /ws/* with 404 instead of SPA fallback.
	@blocked_paths path /health /health/* /docs /docs/* /redoc /redoc/* /openapi.json /metrics /metrics/*
	handle @blocked_paths {
		respond 404
	}

	# 5. Everflow static documentation site (/help, /help/*):
	#    hashed assets under /help/_astro/* are long-cached; HTML is never cached;
	#    missing paths return HTTP 404 with /help/404.html instead of the app SPA.
	@help_assets {
		method GET HEAD
		path /help/_astro/*
	}
	handle @help_assets {
		@help_asset_exists file
		header @help_asset_exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@help_docs {
		method GET HEAD
		path /help /help/*
	}
	handle @help_docs {
		route {
			try_files {path}/index.html {path} {path}.html
			@help_html path *.html
			header @help_html Cache-Control "no-cache, no-store, must-revalidate"
			file_server
		}
	}

	handle_errors {
		@help_404 {
			expression {err.status_code} == 404
			path /help /help/*
			not path /help/_astro/*
		}
		handle @help_404 {
			header Cache-Control "no-cache, no-store, must-revalidate"
			rewrite * /help/404.html
			file_server
		}
		@share_og_fallback {
			expression {err.status_code} >= 500
			vars og_share_fallback 1
		}
		handle @share_og_fallback {
			header Cache-Control "no-cache, no-store, must-revalidate"
			rewrite * /index.html
			file_server {
				status 200
			}
		}
	}

	# 5b. Public share pages (/s/<token>, /a/<token>): render index.html through Caddy
	#     templates with custom <!--@ @--> delimiters so httpInclude injects per-link
	#     OpenGraph <meta> tags from /api/v1/public/og-meta. If the backend is unavailable,
	#     handle_errors (@share_og_fallback) falls back to static index.html (brand name) with 200.
	@share_pages {
		method GET HEAD
		path_regexp share_pages ^/(?:s|a)/[^/]+/?$
	}
	handle @share_pages {
		route {
			vars og_share_fallback 1
			rewrite * /index.html
			header Cache-Control "no-cache, no-store, must-revalidate"
			templates {
				between <!--@ @-->
				mime text/html
			}
			file_server
		}
	}

	# 6. SPA static files & index.html fallback (GET/HEAD only; index.html is never cached).
	@spa_read {
		method GET HEAD
	}
	handle @spa_read {
		route {
			rewrite / /index.html
			try_files {path} /index.html
			@index_doc path /index.html
			header @index_doc Cache-Control "no-cache, no-store, must-revalidate"
			file_server
		}
	}

	# 7. All other paths / methods outside /api/*, /ws/*, and static GET/HEAD return 404.
	handle {
		respond 404
	}
}

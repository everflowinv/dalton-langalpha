{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dalton workflow/skill completion contract",
  "description": "完成契约：一个 workflow 或多步 skill 的交付物清单。dalton_check_done 按它在工作区核对文件、哈希与校验脚本；路径与命令里的 {key} 占位符用运行参数渲染。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "params_required",
    "stages",
    "closing"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "workflow 名（如 initial-coverage）或 skill 目录名（如 dalton-earnings-preview）。"
    },
    "description": {
      "type": "string"
    },
    "draft": {
      "type": "string",
      "description": "主交付草稿的路径模板；closing.check_draft 未写 draft 时用它。"
    },
    "params_required": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "渲染模板必须提供的参数名（workflow 的 RunWorkflow params / skill 的输入参数）。"
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/stage"
      }
    },
    "closing": {
      "$ref": "#/$defs/closing"
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "产物路径模板，相对工作区根；glob=true 时为通配模式。"
        },
        "min_bytes": {
          "type": "integer",
          "minimum": 1,
          "description": "文件最小字节数，防占位空文件。"
        },
        "end_marker": {
          "type": "string",
          "minLength": 1,
          "description": "文件内容必须包含的完成标记，如 <!-- 完成 -->。"
        },
        "glob": {
          "type": "boolean",
          "default": false,
          "description": "path 按通配模式解释，匹配数须 >= min_count。"
        },
        "min_count": {
          "type": "integer",
          "minimum": 1,
          "description": "glob 模式的最少匹配数，默认 1。"
        },
        "optional": {
          "type": "boolean",
          "default": false,
          "description": "缺文件记 warning 而不是 missing（SKILL 原文写明可选的合法缺项，如 weekly-coverage-review 某周无 Watch 命中时的 watch-*.md）。"
        },
        "requires_param": {
          "type": "string",
          "description": "仅当该参数为真值时才要求本产物（如 model_path）。"
        },
        "derive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "json",
            "pointer",
            "field"
          ],
          "properties": {
            "json": {
              "type": "string",
              "description": "JSON 文件路径模板，从中取条目列表。"
            },
            "pointer": {
              "type": "string",
              "description": "顶层键名（如 core / flagged）。"
            },
            "field": {
              "type": "string",
              "description": "每项里取路径参数的字段（如 ticker）。"
            }
          },
          "description": "按 JSON 清单展开本产物模板：每个条目用其 field 值渲染 path。"
        },
        "modified_on": {
          "enum": [
            "as_of",
            "today"
          ],
          "description": "要求文件 mtime 不早于该日 00:00 UTC（核对状态文件是本轮写的）。"
        },
        "requires_json": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "json",
            "field",
            "equals"
          ],
          "properties": {
            "json": {
              "type": "string",
              "minLength": 1,
              "description": "JSON 状态文件路径模板。"
            },
            "field": {
              "type": "string",
              "minLength": 1
            },
            "equals": {
              "type": "string"
            },
            "allowed_values": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              },
              "description": "该字段的全部合法取值（如 [yes, no]）；字段缺失、非字符串或取值不在其中记 missing，不当成条件不成立。"
            }
          },
          "description": "仅当 JSON 状态文件的该字段（必须为字符串，且在 allowed_values 内若声明）等于 equals 时才要求本产物（如 thesis-delta 的 last_run.json material=yes）；状态文件读不到/解析失败/字段缺失或非法记 missing。"
        },
        "sidecars": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "suffix",
              "min_bytes"
            ],
            "properties": {
              "suffix": {
                "type": "string",
                "minLength": 1,
                "description": "替换草稿 .md 后缀得到的侧车后缀（如 .annotated.md，check_draft 的落盘约定）。"
              },
              "min_bytes": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "description": "从本产物路径推导的侧车文件（draft stem + suffix），同样要求存在且达到 min_bytes。"
        },
        "path_param": {
          "type": "string",
          "description": "参数名：params 里带该参数时，用它的值（可含占位符）替代 path 模板作为产物路径——agent 显式给出本次实际写入的文件时优先于按日期猜。"
        },
        "variant_glob": {
          "type": "string",
          "description": "path 模板渲染结果不存在（或存在但不是本轮写入）时的同目录通配（如 research/*-delta.md，可含 {key} 占位符）；只接受本轮窗口内（mtime ≥ 运行开始时间）的最新匹配，防止旧文件顶替本轮交付。"
        },
        "fresh_this_run": {
          "type": "boolean",
          "default": false,
          "description": "该产物是本轮必须写出的交付物（唤醒技能的笔记/草稿/predictions.json/last_run.json 等）：无论经模板、显式路径还是 variant 找到，都要求 mtime 落在本轮窗口内。未标注的产物不做本轮窗口判定（合法复用上一轮的文件，如 dalton-publish 审批后的原草稿、workflow resume 复用的文件）。"
        }
      }
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "description": "在工作区根重跑的校验命令，沿用 SKILL 里的现有命令。"
        },
        "pass_when": {
          "enum": [
            "exit_zero",
            "output_contains",
            "output_not_contains"
          ],
          "default": "exit_zero",
          "description": "通过判据：退出码 0（默认），或输出包含/不包含 expect。"
        },
        "expect": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent",
        "verdicts"
      ],
      "properties": {
        "agent": {
          "const": "dalton-reviewer"
        },
        "verdicts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "pass",
              "revise",
              "block"
            ]
          },
          "description": "可接受的结构化结论；revise 必须已走完修订→复审。"
        },
        "manual_sidecar": {
          "type": "string",
          "minLength": 1,
          "description": "手动降级路径（workflow.enabled=false，本线程无 workflow run 目录）时由主智能体保存的审稿 JSON 路径模板，内容为 {verdict, draft_sha256}（或其数组，取最后一条）；dalton_check_done 传 params.manual=true 时据此核对审稿。"
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "requires_param": {
          "type": "string",
          "description": "仅当该参数为真值时才检查本阶段。"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "validators": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/validator"
          }
        },
        "review": {
          "$ref": "#/$defs/review"
        }
      }
    },
    "closing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "knowledge_docs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "每一个都必须有 source=tool 的新版本（自 since 日期零点起）。"
        },
        "knowledge_docs_any": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "至少其中一个有 source=tool 的新版本。"
        },
        "knowledge_source": {
          "const": "tool"
        },
        "verdict_kinds_any": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "必须写入的 verdict 类型（如 NEW_THESIS），任一命中即可。"
        },
        "verdict_trigger": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          ],
          "description": "verdict 的 trigger_kind 须等于该值或命中数组任一值（如 filing/manual）。"
        },
        "check_draft": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "draft"
          ],
          "properties": {
            "draft": {
              "type": "string",
              "description": "草稿路径模板。"
            },
            "required": {
              "type": "boolean",
              "default": true,
              "description": "false 时草稿缺席只记 warning（如 bullbear-doc 的 check_draft 为可选步骤）。"
            }
          }
        },
        "language_review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "draft"
          ],
          "properties": {
            "draft": {
              "type": "string",
              "minLength": 1,
              "description": "终稿路径模板；核对 <draft>.language.json。"
            },
            "required": {
              "type": "boolean",
              "default": true,
              "description": "false 时缺项只记 warning。"
            }
          },
          "description": "语言审查：终稿的 <draft>.language.json 存在且含第 1、2 轮记录，最后一条第 2 轮的 draft_sha256 与最后一次独立审稿通过时的哈希一致或与当前终稿一致；读不到、缺轮次或哈希对不上记 missing。契约同时声明 gated_draft 且其草稿不存在（门禁未过分支）时跳过本检查。"
        },
        "push_draft": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "推送稿路径模板（只用契约 params_required 里的参数渲染）。"
            },
            "skip_when_no_change": {
              "type": "boolean",
              "default": false,
              "description": "为 true 时，本轮 verdict 为 NO_CHANGE 且推送稿不存在（或不是本轮写的）就跳过本规则。"
            }
          },
          "description": "推送稿审查：要求推送稿文件存在、修改时间不早于本轮运行开始时间，且完成两轮语言审查（最后一条第 2 轮 draft_sha256 等于当前文件哈希）。"
        },
        "knowledge_docs_requires_param": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "doc → 参数名：仅当该参数为真值时才要求该 doc 的 source=tool 新版本。"
        },
        "knowledge_docs_if_json": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "json",
              "when"
            ],
            "properties": {
              "json": {
                "type": "string",
                "description": "JSON 文件路径模板。"
              },
              "docs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "docs_any": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
                  "when": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "field": {
                        "type": "string"
                      },
                      "equals": {
                        "type": "string",
                        "description": "字段值相等时生效。"
                      },
                      "allowed_values": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                          "type": "string"
                        },
                        "description": "该字段的全部合法取值（如 [yes, no]）；字段缺失、非字符串或取值不在其中记 missing，不当成条件不成立。"
                      },
                      "any_gt": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string"
                        },
                        "description": "这些数值字段之和 > 0 时生效。"
                      }
                    }
                  }
            }
          },
          "description": "按 JSON 状态文件的条件要求知识文档新版本；读不到/解析失败记 missing。"
        },
        "knowledge_docs_any_unless_no_change": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "本轮命中 verdict_kinds_any/verdict_trigger 的 verdict 里有 word 不是 NO_CHANGE 时，至少其一须有 source=tool 新版本（stock-move / filing-review 的条件知识更新）。"
        },
        "published_or_awaiting_pm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "draft",
            "published"
          ],
          "properties": {
            "draft": {
              "type": "string",
              "minLength": 1,
              "description": "草稿路径模板，匹配本工作区 awaiting_pm 发布请求的 draft_path。"
            },
            "published": {
              "type": "string",
              "minLength": 1,
              "description": "published/ 不可变副本路径模板（如 published/{as_of}-{slug}.md）。"
            }
          },
          "description": "发布状态二选一：published/ 副本已存在，或本工作区有 draft_path 匹配的 awaiting_pm 请求；都没有（或查询失败）记 missing。"
        },
        "gated_draft": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "draft",
            "absent_verdict_kinds_any"
          ],
          "properties": {
            "draft": {
              "type": "string",
              "minLength": 1,
              "description": "门禁通过分支的正式草稿路径模板。"
            },
            "min_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "absent_verdict_kinds_any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              },
              "description": "草稿不存在（门禁未过分支）时本轮须有的 verdict word（如 NO_CHANGE）。"
            }
          },
          "description": "门禁两分支（dalton-call）：草稿存在＝门禁通过，要求草稿足量且 check_draft 侧车哈希一致；草稿不存在＝门禁未过，要求本轮有 absent_verdict_kinds_any 的 verdict；两者都没有或读取出错＝无法判定，记 missing。"
        }
      },
      "dependentRequired": {
        "knowledge_docs_any_unless_no_change": [
          "verdict_kinds_any"
        ]
      }
    }
  }
}

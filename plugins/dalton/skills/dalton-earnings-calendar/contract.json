{
  "name": "dalton-earnings-calendar",
  "params_required": [
    "as_of"
  ],
  "stages": [
    {
      "name": "财报日历周报",
      "artifacts": [
        {
          "path": "dalton/research/earnings-scan-{as_of}.jsonl",
          "path_param": "scan_file",
          "variant_glob": "dalton/research/earnings-scan-*.jsonl",
          "min_bytes": 10,
          "fresh_this_run": true,
          "requires_scan_dates_status": true
        }
      ]
    }
  ],
  "closing": {
    "push_draft": {
      "path": "research/push/{as_of}-earnings-calendar.md"
    },
    "earnings_calendar_mirror": {
      "ledger": "dalton/earnings-calendar.json"
    },
    "calendar_wake_signal": {
      "probe": "calendar"
    }
  }
}

{
  "name": "dalton-stock-move",
  "description": "股价异动归因的完成契约：归因笔记落盘 research/ + 事件五词 verdict（trigger_kind=price_move）；本轮 verdict 非 NO_CHANGE 时至少一份 thesis/debate/drivers/management 有本轮 source=tool 新版本（对应 dalton-stock-move SKILL 第 8–9 步）。",
  "params_required": [
    "ticker",
    "as_of"
  ],
  "stages": [
    {
      "name": "归因笔记",
      "artifacts": [
        {
          "path": "research/{as_of}-stock-move.md",
          "min_bytes": 200
        }
      ]
    }
  ],
  "closing": {
    "verdict_kinds_any": [
      "NO_CHANGE",
      "THESIS_STRENGTHENED",
      "THESIS_WEAKENED",
      "THESIS_BROKEN",
      "NEW_THESIS"
    ],
    "verdict_trigger": "price_move",
    "knowledge_docs_any_unless_no_change": [
      "thesis",
      "debate",
      "drivers",
      "management"
    ],
    "push_draft": {
      "path": "research/push/{as_of}-stock-move.md",
      "skip_when_no_change": true
    }
  }
}

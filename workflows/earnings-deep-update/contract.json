{
  "name": "earnings-deep-update",
  "description": "财报深度链的完成契约：八节点评 + 模型更新 + 对账校准 + 审稿 + 知识层修订草案（对应 dalton-earnings-deep SKILL 的交付物）。",
  "draft": "drafts/{release_date}-deep-{quarter}.md",
  "params_required": [
    "ticker",
    "quarter",
    "workspace_dir",
    "release_date"
  ],
  "stages": [
    {
      "name": "八节深度点评",
      "artifacts": [
        {
          "path": "drafts/{release_date}-deep-{quarter}.md",
          "min_bytes": 500
        }
      ]
    },
    {
      "name": "模型更新",
      "requires_param": "model_path",
      "artifacts": [
        {
          "path": "research/{release_date}-deep-{quarter}/model_dump/model-verification.json",
          "min_bytes": 50
        }
      ],
      "validators": [
        {
          "command": "python3 .agents/skills/dalton-model/scripts/model_check.py verify-done --workspace {workspace_dir} --ticker {ticker} --research-dir research/{release_date}-deep-{quarter} --expected-workflow earnings-deep-update",
          "pass_when": "exit_zero",
          "description": "按终态账本核对最终模型可读性、哈希、已完成阶段证据、失败阶段记录及 mapping.md / model-delta.md 状态"
        }
      ]
    },
    {
      "name": "校准与对账",
      "artifacts": [
        {
          "path": "research/{release_date}-deep-{quarter}/thesis-calibration.md",
          "min_bytes": 100
        },
        {
          "path": "research/{release_date}-deep-{quarter}/management-delta.md",
          "min_bytes": 50
        },
        {
          "path": "research/{release_date}-deep-{quarter}/reconcile.md",
          "min_bytes": 50
        },
        {
          "path": "research/{release_date}-deep-{quarter}/reconcile.json",
          "min_bytes": 10
        }
      ]
    },
    {
      "name": "审稿",
      "review": {
        "agent": "dalton-reviewer",
        "verdicts": [
          "pass"
        ],
        "manual_sidecar": "research/{release_date}-deep-{quarter}/review.json"
      }
    },
    {
      "name": "知识层修订草案",
      "artifacts": [
        {
          "path": "research/{release_date}-deep-{quarter}/knowledge-revision.json",
          "min_bytes": 50
        }
      ]
    }
  ],
  "closing": {
    "knowledge_docs": [
      "thesis",
      "debate",
      "drivers",
      "management"
    ],
    "knowledge_source": "tool",
    "verdict_kinds_any": [
      "NO_CHANGE",
      "THESIS_STRENGTHENED",
      "THESIS_WEAKENED",
      "THESIS_BROKEN",
      "NEW_THESIS"
    ],
    "verdict_trigger": "earnings",
    "check_draft": {
      "draft": "drafts/{release_date}-deep-{quarter}.md"
    },
    "knowledge_docs_requires_param": {
      "models": "model_path"
    },
    "knowledge_docs_if_json": [
      {
        "json": "research/{release_date}-deep-{quarter}/reconcile.json",
        "when": {
          "any_gt": [
            "wrong",
            "partial"
          ]
        },
        "docs": [
          "lessons"
        ]
      }
    ],
    "language_review": {
      "draft": "drafts/{release_date}-deep-{quarter}.md"
    },
    "push_draft": {
      "path": "research/push/{release_date}-earnings-deep-{quarter}.md"
    }
  }
}

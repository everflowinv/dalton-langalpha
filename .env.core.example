# =============================================================================
# Dalton Standalone Core Environment Template (.env.core.example)
# =============================================================================
# Recommended: run `bash scripts/standalone/init.sh` to check your environment
# and auto-generate all secrets into `.env`, then run `make config` to set up
# your LLM provider, financial data, and optional web search keys.
#
# Start command:
#   docker compose -f docker-compose.yml -f docker-compose.core.yml up -d
# =============================================================================

# -----------------------------------------------------------------------------
# Deployment Profile & Branding
# -----------------------------------------------------------------------------
APP_ENV=core
DALTON_PROFILE=core

# Upstream host mode stays "oss" for self-hosted deployments.
HOST_MODE=oss
# Authentication mode: "oss" (single-user trial, no sign-in) or "local" (multi-user
# accounts). Core trials use "oss" until the local sign-in pages ship; "oss" in the
# core profile also needs the explicit trial flag below.
DALTON_AUTH_MODE=oss
DALTON_ALLOW_DEV_OSS_AUTH=1
# Default user ID when DALTON_AUTH_MODE=oss.
AUTH_USER_ID=local-dev-user

# Custom brand name (default: Dalton) and default timezone (default: UTC).
BRAND_NAME=Dalton
VITE_BRAND_NAME=Dalton
VITE_BRAND_MARK=langalpha
VITE_DALTON_UI=true
VITE_DALTON_AUTH=
DALTON_TIMEZONE=UTC

# -----------------------------------------------------------------------------
# Domain, Edge Gateway & Backend Workers
# -----------------------------------------------------------------------------
# Use "localhost" for local loopback trial (127.0.0.1:8088).
DOMAIN=localhost
DALTON_EDGE_PORT=8088
SERVER_BASE_URL=http://127.0.0.1:8088
PUBLIC_APP_URL=http://127.0.0.1:8088
DALTON_INVITE_EMAIL_DOMAIN=team.dalton.local
BACKEND_WORKERS=2

# -----------------------------------------------------------------------------
# Sandbox & Dedicated Per-Instance Sandbox Network
# -----------------------------------------------------------------------------
# Default deployment assumes one Standalone Core stack per dedicated Docker host
# (Docker Engine >= 28.0 required for reliable 127.0.0.1 loopback port isolation).
# Compose and DockerProvider share SANDBOX_DOCKER_NETWORK (auto-populated per
# install instance by init.sh as `${COMPOSE_PROJECT_NAME}_sandbox`).
COMPOSE_PROJECT_NAME=
SANDBOX_PROVIDER=docker
DOCKER_HOST_SOCKET=/var/run/docker.sock
SANDBOX_DOCKER_NETWORK=

# Sandboxes attach to SANDBOX_DOCKER_NETWORK (isolated from postgres/redis/minio
# on `core_internal`) and reach LiveFS, egress relay, and the HMAC-signed chat
# upload download relay via `http://backend:8000` (never host.docker.internal).
EGRESS_RELAY_BASE_URL=http://backend:8000
# Auto-generated by scripts/standalone/init.sh (`openssl rand -hex 32`).
EGRESS_RELAY_SECRET=

# -----------------------------------------------------------------------------
# PostgreSQL (managed by docker-compose.core.yml on core_internal)
# -----------------------------------------------------------------------------
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
# Auto-generated by scripts/standalone/init.sh (`openssl rand -hex 32`).
DB_PASSWORD=
DB_NAME=postgres
DB_SSLMODE=prefer

# -----------------------------------------------------------------------------
# Redis (managed by docker-compose.core.yml on core_internal)
# -----------------------------------------------------------------------------
# Auto-generated by scripts/standalone/init.sh (`openssl rand -hex 32`).
REDIS_PASSWORD=
# REDIS_URL is constructed automatically from REDIS_PASSWORD in compose.

# -----------------------------------------------------------------------------
# MinIO & Chat Large-File Upload Storage (core_internal only)
# -----------------------------------------------------------------------------
# Auto-generated by scripts/standalone/init.sh (`openssl rand -hex 32`).
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Decoupled chat upload storage variables (take precedence over DALTON_ASR_STORAGE_*).
DALTON_CHAT_UPLOAD_STORAGE_ENDPOINT_URL=http://minio:9000
DALTON_CHAT_UPLOAD_STORAGE_BUCKET_NAME=chat-uploads
DALTON_CHAT_UPLOAD_STORAGE_ACCESS_KEY_ID=
DALTON_CHAT_UPLOAD_STORAGE_SECRET_ACCESS_KEY=
DALTON_CHAT_UPLOAD_STORAGE_REGION=us-east-1
DALTON_CHAT_UPLOAD_STORAGE_ADDRESSING_STYLE=path
DALTON_CHAT_UPLOAD_STORAGE_KEY_PREFIX=

# -----------------------------------------------------------------------------
# Security Secrets (auto-generated by scripts/standalone/init.sh)
# -----------------------------------------------------------------------------
# Dedicated random HMAC secret for short-lived sandbox chat-upload relay tokens
# (required in core mode; falls back only to INTERNAL_SERVICE_TOKEN if unset).
DALTON_CHAT_UPLOAD_SIGNING_SECRET=
# Internal service-to-service token (backend <-> crawler and internal dispatch).
INTERNAL_SERVICE_TOKEN=
# Encryption key for BYOK API keys stored at rest.
BYOK_ENCRYPTION_KEY=
# JWT signing secret for local multi-user authentication (Batch 4+).
JWT_SIGNING_SECRET=
# One-time first-admin bootstrap token (Batch 4+).
BOOTSTRAP_SETUP_TOKEN=
# Optional comma-separated operator-approved private LLM endpoints (e.g. corporate gateway / CI fake-llm).
DALTON_OPERATOR_LLM_ENDPOINTS=

# -----------------------------------------------------------------------------
# Compliance / SEC EDGAR Identity (recommended)
# -----------------------------------------------------------------------------
# Format: "<Brand> <contact-email@example.com>" per SEC fair-access policy.
SEC_USER_AGENT=

# -----------------------------------------------------------------------------
# LLM Provider API Keys (configure via `make config` or the web UI /setup)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
MINIMAX_API_KEY=
ZAI_API_KEY=

# -----------------------------------------------------------------------------
# Optional Financial Data & Web Search / Fetch Keys (configure via `make config`)
# -----------------------------------------------------------------------------
# Leave empty to use key-free yfinance market data, dalton_sec, and inhouse web fetch.
# WebSearch is hidden automatically when no search provider key is configured.
FMP_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
EXA_API_KEY=
PARALLEL_API_KEY=
FIRECRAWL_API_KEY=

# -----------------------------------------------------------------------------
# Image Build Options
# -----------------------------------------------------------------------------
# Set INSTALL_BROWSER_CRAWLER=false in CI or constrained hosts to skip Chromium install at build time.
INSTALL_BROWSER_CRAWLER=true
BUILD_GIT_SHA=standalone
BUILD_GIT_DIRTY=false

# Dalton offsite backup configuration (~/.config/dalton/offsite-backup.env, chmod 0600)
# Copy to ~/.config/dalton/offsite-backup.env and adjust paths for the host.
# Never put real secrets, tokens, or passphrases in this example file.

# ---------------------------------------------------------------------------
# Shared logging, encryption key, and alerts (B1 / B5 / B7)
# ---------------------------------------------------------------------------
DALTON_OFFSITE_BACKUP_LOG_FILE="${HOME}/Library/Logs/dalton-offsite-backup.log"

# Line-oriented alert log appended on any backup failure or WARN condition.
# Note: DALTON_OPS_ALERTS_FILE in ~/.config/dalton/channel-gateway.env points to a
# JSON config file (ops-alerts.json) for dalton-channel-gateway; scripts guard
# against appending log lines to .json files and write here instead.
DALTON_BACKUP_ALERTS_FILE="${HOME}/Library/Logs/dalton-offsite-backup-alerts.log"
DALTON_CHANNEL_GATEWAY_ENV_FILE="${HOME}/.config/dalton/channel-gateway.env"

# Optional loopback gateway notification on backup failure (POST /internal/ops-alerts, code=backup_failed)
# Fill INTERNAL_SERVICE_TOKEN in ~/.config/dalton/offsite-backup.env (mode 0600); never print or commit it.
DALTON_CHANNEL_GATEWAY_URL="http://127.0.0.1:8962"
INTERNAL_SERVICE_TOKEN=""

# Encryption passphrase file (mode 0600; auto-generated if missing; NEVER enters git/Drive)
DALTON_BACKUP_KEY_FILE="${HOME}/.config/dalton/backup.key"

# ---------------------------------------------------------------------------
# B2: Config backup -> private GitHub repository (every 6 hours)
# ---------------------------------------------------------------------------
DALTON_CONFIG_BACKUP_REPO_DIR="${HOME}/Backups/dalton-config-repo"
DALTON_PROD_CHECKOUT_DIR="${HOME}/Projects/dalton-langalpha"
DALTON_PROD_VAR_DIR="${HOME}/Projects/dalton-langalpha/var/dalton"
DALTON_USER_CONFIG_DIR="${HOME}/.config/dalton"
DALTON_LAUNCHAGENTS_DIR="${HOME}/Library/LaunchAgents"
DALTON_BACKUP_SCRIPTS_DIR="${HOME}/Backups/dalton"
DALTON_COLIMA_DIR="${HOME}/.colima"

# Single file size cap in MiB (oversized files are skipped and logged)
DALTON_CONFIG_MAX_FILE_MB="20"

# Comma-separated exclusion lists
DALTON_CONFIG_VAR_EXCLUDES="openclaw-data/temp,openclaw-data/research-outputs,pr_baseline,tmp,.dalton-runs,backups,*.dump,*.sqlite,*.sqlite-wal,*.sqlite-shm"
DALTON_CONFIG_USER_EXCLUDES="*.log,*.pid,*.sock"
DALTON_LAUNCHAGENTS_GLOBS="com.dalton.*.plist"
DALTON_BACKUP_SCRIPTS_GLOBS="*.sh,*.py"
DALTON_CONFIG_COLIMA_EXCLUDES="_disks,_lima/_disks,*.img,*.qcow2,*.raw,*.vmdk,*.sock,*.pid,*.log,*.stdout,*.stderr,cidata.iso,diffdisk,datadisk"
DALTON_CONFIG_PROD_OVERRIDE_PATTERNS=".env,.env.local,.env.production,.env.*.overlay,*.production.yaml,agent_config.dalton*.yaml,config.dalton*.yaml,docker-compose.prod.yml,docker-compose.override.yml,data_routing.yaml,scripts/load_env.sh"

# Retry delay (seconds) before the single retry on git push failure
DALTON_GIT_PUSH_RETRY_DELAY_SEC="5"

# ---------------------------------------------------------------------------
# B3: Weekly data backup -> External SSD + Google Drive via rclone (Sunday 05:00)
# ---------------------------------------------------------------------------
# External drive mount root; script aborts if not mounted (never falls back to /)
DALTON_EXTERNAL_MOUNT_ROOT="/Volumes/EveSSD"
DALTON_WEEKLY_BACKUP_ROOT="/Volumes/EveSSD/Dalton/backups/weekly"
DALTON_EXTERNAL_TMP_ROOT="/Volumes/EveSSD/Dalton/backups/.tmp"
DALTON_EXTERNAL_RETAIN_WEEKS="8"

# Docker & Postgres sources
DALTON_MINIO_VOLUME="dalton-langalpha_dalton-minio-data"
DALTON_DOCKER_HELPER_IMAGE="alpine:3.20"
DALTON_SANDBOX_CONTAINER_PREFIX="langalpha-sandbox-"
DALTON_SANDBOX_MAX_SIZE_GB="5"
DALTON_REDIS_CONTAINER="dalton-langalpha-redis-1"
DALTON_PROD_ENV_FILE="${HOME}/Projects/dalton-langalpha/.env"
DALTON_PG_BACKUP_DIR="${HOME}/Backups/dalton"

# rclone Google Drive target (all cache/temp/logs stay on external drive; B8b unsets proxy env vars for rclone)
DALTON_RCLONE_REMOTE="gdrive"
DALTON_RCLONE_DRIVE_DIR="DaltonBackup"
DALTON_DRIVE_RETAIN_WEEKS="4"
DALTON_DB_RETAIN_COUNT="7"
DALTON_RCLONE_CACHE_DIR="/Volumes/EveSSD/Dalton/backups/.rclone-cache"
DALTON_RCLONE_LOG_DIR="/Volumes/EveSSD/Dalton/backups/.rclone-logs"

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent template for Dalton portwatch (ephemeral TCP port usage sampler, every 300s).
  Install to ~/Library/LaunchAgents/com.dalton.portwatch.plist:
    1. Replace __REPO__, __HOME__, and __LOG_DIR__ with the host paths.
    2. Load with: launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.dalton.portwatch.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dalton.portwatch</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__REPO__/scripts/dalton/ops/prod/portwatch.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__REPO__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/Applications/Docker.app/Contents/Resources/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>
    <key>ProcessType</key>
    <string>Background</string>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>StandardOutPath</key>
    <string>__LOG_DIR__/dalton-portwatch.out.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/dalton-portwatch.err.log</string>
</dict>
</plist>

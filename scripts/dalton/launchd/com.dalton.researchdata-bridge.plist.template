<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dalton.researchdata-bridge</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON_BIN__</string>
        <string>__REPO_ROOT__/scripts/dalton/researchdata_bridge.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__OCW_ROOT__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>DALTON_OCW_ROOT</key>
        <string>__OCW_ROOT__</string>
        <key>DALTON_BRIDGE_ENV_FILE</key>
        <string>__HOME__/.config/dalton/researchdata-bridge.env</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/dalton-researchdata-bridge.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/dalton-researchdata-bridge.err.log</string>
</dict>
</plist>

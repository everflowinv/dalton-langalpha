# Dalton backend image extending deploy/Dockerfile.dev with build-time git installation
# and mandatory build-time git SHA + dirty flag + file manifest recording (P0J Round-4 Must-Fix #7).
# Shares the exact top layers of deploy/Dockerfile.dev for 100% Docker layer cache reuse.
# sync5 (#752): the chart render page chartkit snapshots with, built apart from the web
# app (web/vite.chart-render.config.js) exactly as deploy/Dockerfile.dev does. Without it a
# snapshot reports itself unavailable.
FROM node:24-alpine AS chart-render
WORKDIR /web
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
COPY web/patches/ patches/
RUN npm install -g "$(node -p 'require("./package.json").packageManager')"
# Plain install, no BuildKit cache mount: the production host builds with the classic builder
# (no buildx), which rejects `RUN --mount`.
RUN pnpm install --frozen-lockfile
COPY web/chart-render.html web/vite.chart-render.config.js web/postcss.config.js web/tsconfig*.json ./
COPY web/scripts/react-plugins.ts scripts/react-plugins.ts
COPY web/src/ src/
RUN CHART_RENDER_OUT_DIR=/chart-render pnpm run build:chart-render

FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    postgresql-client \
    tini \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

COPY pyproject.toml uv.lock README.md ./
# sync3 B9: no COPY of libs/ptc-cli — Dalton does not ship the `la` CLI (the
# feature is off; cli/ is neither built nor packaged, and computer_cli_tokens
# never mint). The backend imports nothing from it; pnpm builds it in cli/.
COPY libs/market-protocol/ libs/market-protocol/
# sync5: libs/chartkit is a path dependency in pyproject.toml, so uv sync needs it here.
COPY libs/chartkit/ libs/chartkit/
# sync6: libs/edgar-engine is a path dependency in pyproject.toml, so uv sync needs it here.
COPY libs/edgar-engine/ libs/edgar-engine/

ARG INSTALL_OBSERVABILITY=false
ARG UV_CONCURRENT_DOWNLOADS=4
RUN if [ "$INSTALL_OBSERVABILITY" = "true" ]; then \
        uv sync --frozen --no-dev --extra observability; \
    else \
        uv sync --frozen --no-dev; \
    fi

ARG INSTALL_BROWSER_CRAWLER=true
RUN if [ "$INSTALL_BROWSER_CRAWLER" = "true" ]; then \
        uv run patchright install --with-deps chromium \
        && uv run scrapling install; \
    fi

# Install git + OC-1 data-task APT packages (poppler-utils, fonts-noto-cjk) + ffmpeg/ffprobe for transcription service
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ffmpeg \
    poppler-utils \
    fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/* \
    && git config --system --add safe.directory '*' \
    && mkdir -p /opt/homebrew/bin \
    && ln -s /app/.venv/bin/python /opt/homebrew/bin/python3 \
    && ln -s /app/.venv/bin/python /opt/homebrew/bin/python3.14

COPY src/ src/
# compose bind-mounts ./libs/chartkit, which hides the render page copied into it, so a
# second copy sits outside the mount (same as deploy/Dockerfile.dev).
COPY --from=chart-render /chart-render/ libs/chartkit/chartkit/render/
COPY --from=chart-render /chart-render/ /opt/chart-render/
ENV CHARTKIT_RENDER_DIR=/opt/chart-render
COPY server.py .
COPY scripts/ scripts/
COPY config*.yaml ./
COPY agent_config*.yaml ./
COPY alembic.ini .
COPY migrations/ migrations/
COPY mcp_servers/ mcp_servers/
COPY plugins/ plugins/
COPY workflows/ workflows/
COPY config/dalton/ config/dalton/

COPY scripts/docker_entrypoint.sh /docker_entrypoint.sh
RUN chmod +x /docker_entrypoint.sh

# Mandatory build-time git SHA and dirty status (fail build if missing/invalid) +
# deterministic SHA-256 manifest of bind-mounted code/config paths so startup detects any drift or new files.
# libs/chartkit is bind-mounted too; its render/ copy is image-only (hidden by the mount), so it is left out.
ARG BUILD_GIT_SHA=""
ARG BUILD_GIT_DIRTY=""
RUN if [ -z "$BUILD_GIT_SHA" ] || [ "$BUILD_GIT_SHA" = "unknown" ]; then \
        echo "ERROR: BUILD_GIT_SHA build arg is required and must not be empty or unknown" >&2; \
        exit 1; \
    fi \
    && if [ "$BUILD_GIT_DIRTY" != "true" ] && [ "$BUILD_GIT_DIRTY" != "false" ]; then \
        echo "ERROR: BUILD_GIT_DIRTY build arg is required and must be 'true' or 'false'" >&2; \
        exit 1; \
    fi \
    && printf '%s\n' "$BUILD_GIT_SHA" | cut -c1-8 > /app/.build_git_sha \
    && printf '%s\n' "$BUILD_GIT_DIRTY" > /app/.build_git_dirty \
    && set -- \
    && for p in server.py config.yaml config.dalton.yaml config.core.yaml agent_config.yaml agent_config.dalton.yaml agent_config.core.yaml alembic.ini \
            config/dalton libs/market-protocol libs/chartkit libs/edgar-engine src scripts migrations mcp_servers plugins workflows; do \
        if [ -e "$p" ]; then set -- "$@" "$p"; fi; \
    done \
    && find "$@" \
            -type f ! -path 'libs/chartkit/chartkit/render/*' ! -path '*/__pycache__/*' ! -path '*/.pytest_cache/*' ! -path '*/.ruff_cache/*' ! -name '*.pyc' ! -name '*.pyo' ! -name '.DS_Store' -print0 \
       | sort -z \
       | xargs -0 sha256sum > /app/.build_files.sha256

EXPOSE 8000

ENTRYPOINT ["tini", "--", "/docker_entrypoint.sh"]
CMD ["uv", "run", "uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]

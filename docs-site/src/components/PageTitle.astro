---
import type { StarlightRouteData } from '@astrojs/starlight/route-data';
type SidebarEntry = StarlightRouteData['sidebar'][number];

const PAGE_TITLE_ID = '_top';

function findSidebarGroupLabel(entries: SidebarEntry[], parents: string[] = []): string | undefined {
	for (const entry of entries) {
		if (entry.type === 'link') {
			if (entry.isCurrent) {
				return parents[parents.length - 1];
			}
		} else if (entry.type === 'group') {
			const match = findSidebarGroupLabel(entry.entries, [...parents, entry.label]);
			if (match) return match;
		}
	}
	return undefined;
}

const { entry, sidebar } = Astro.locals.starlightRoute;
const groupLabel = findSidebarGroupLabel(sidebar);
---

<div class="ef-page-title">
	{
		groupLabel && (
			<p class="ef-page-title__eyebrow">
				<span class="ef-page-title__dot" aria-hidden="true" />
				<span>{groupLabel}</span>
			</p>
		)
	}
	<h1 id={PAGE_TITLE_ID}>{entry.data.title}</h1>
</div>

<style>
	.ef-page-title {
		margin-top: 0.5rem;
	}

	.ef-page-title__eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0 0 0.75rem 0;
		font-family: var(--ef-font-mono);
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--ef-text-secondary);
		line-height: 1.2;
	}

	.ef-page-title__dot {
		width: 0.375rem;
		height: 0.375rem;
		border-radius: 999px;
		background: var(--ef-accent);
		flex-shrink: 0;
	}

	h1 {
		margin: 0;
		font-family: var(--ef-font-ui);
		font-size: var(--sl-text-h1);
		line-height: var(--sl-line-height-headings);
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--ef-text);
	}
</style>

---
import type { ImageMetadata } from 'astro';
import { LinkButton } from '@astrojs/starlight/components';
import DraftContentNotice from '@astrojs/starlight/components/DraftContentNotice.astro';
import HeroImageSlot from './HeroImageSlot.astro';

const PAGE_TITLE_ID = '_top';

const { entry } = Astro.locals.starlightRoute;
const { data } = entry;
const { title = data.title, tagline, image, actions = [] } = data.hero || {};

const isNotFound = entry.id === '404' || entry.id.endsWith('/404');
const lines = String(title)
	.trim()
	.split(/\r?\n|<br\s*\/?>/i)
	.map((line) => line.trim())
	.filter(Boolean);

let darkImage: ImageMetadata | undefined;
let lightImage: ImageMetadata | undefined;
let rawHtml: string | undefined;
if (image) {
	if ('file' in image) {
		darkImage = image.file;
	} else if ('dark' in image) {
		darkImage = image.dark;
		lightImage = image.light;
	} else {
		rawHtml = image.html;
	}
}
---

<section class="ef-hero">
	{
		!isNotFound && (
			<p class="ef-hero__eyebrow">
				<span class="ef-eyebrow-dot" aria-hidden="true" />
				<span>EVERFLOW 文档</span>
			</p>
		)
	}

	<h1 id={PAGE_TITLE_ID} data-page-title class="ef-hero__title">
		{
			lines.map((line, index) => (
				<span
					class:list={[
						'ef-hero__line',
						{ 'ef-hero__line--muted': lines.length > 1 && index === lines.length - 1 },
					]}
				>
					{line}
				</span>
			))
		}
	</h1>

	{data.draft && <DraftContentNotice />}

	{tagline && <p class="ef-hero__tagline" set:html={tagline} />}

	{
		actions.length > 0 && (
			<div class="ef-hero__actions">
				{actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
					<LinkButton
						{href}
						{variant}
						icon={icon?.name}
						class:list={['ef-hero__pill', className]}
						{...attrs}
					>
						{text}
						{icon?.html && <Fragment set:html={icon.html} />}
					</LinkButton>
				))}
			</div>
		)
	}

	<HeroImageSlot darkSrc={darkImage} lightSrc={lightImage} alt={image?.alt}>
		{rawHtml && <Fragment set:html={rawHtml} />}
	</HeroImageSlot>
</section>

<style>
	.ef-hero {
		padding-block: clamp(2rem, 5vw, 3.75rem) clamp(1.25rem, 2.5vw, 2rem);
		max-width: 56rem;
	}

	.ef-hero__eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0 0 1.25rem 0;
		font-family: var(--ef-font-mono);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--ef-text-secondary);
	}

	.ef-eyebrow-dot {
		width: 0.375rem;
		height: 0.375rem;
		border-radius: 999px;
		background: var(--ef-accent);
		flex-shrink: 0;
	}

	.ef-hero__title {
		margin: 0;
		font-family: var(--ef-font-ui);
		font-size: clamp(2.25rem, 1.4rem + 3.4vw, 3.75rem);
		font-weight: 700;
		line-height: 1.12;
		letter-spacing: -0.03em;
		color: var(--ef-text);
	}

	.ef-hero__line {
		display: block;
	}

	.ef-hero__line--muted {
		color: var(--ef-text-secondary);
	}

	.ef-hero__tagline {
		margin: 1.5rem 0 0 0;
		max-width: 39rem;
		font-size: clamp(1rem, 0.95rem + 0.25vw, 1.09375rem);
		line-height: 1.7;
		color: var(--ef-text-secondary);
	}

	.ef-hero__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
		margin-top: 2rem;
	}

	.ef-hero__actions :global(.ef-hero__pill) {
		border-radius: 999px;
		padding: 0.625rem 1.35rem;
		font-size: 0.9375rem;
		font-weight: 500;
		line-height: 1.4;
		margin: 0;
	}
</style>
